# NWRMP deployment settings. Copy to deploy/.env and fill in:
#   cp .env.example .env && chmod 600 .env

# Address users type to reach the server: its IP address for now (e.g. 10.20.30.40),
# or a DNS name later (e.g. nwrmp.example.gov). Used by the certificate scripts.
NWRMP_HOST=

# Database password: letters and digits only (it is placed in a connection URL).
# Generate one with:  openssl rand -hex 24
# Only used when the database is first created; changing it later needs ALTER USER (see the runbook).
POSTGRES_PASSWORD=

# Server time zone for logs and timestamps
TZ=Africa/Mogadishu

# Image tag, e.g. the git commit or release being deployed
NWRMP_VERSION=latest

# Database connections per API instance
PG_POOL_MAX=10

# Optional: basemap style URL (defaults to OpenFreeMap, which needs internet access from users' devices)
VITE_MAP_STYLE_URL=
