# Copy to .env for local development.

# PostgreSQL connection string (PostGIS must be available).
# Leave empty to use the embedded local database (PGlite + PostGIS) stored in ./.pglite
# For Neon: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# Port for the local API server
PORT=3001

# Comma-separated list of allowed browser origins. Empty = allow all (test only).
CORS_ORIGIN=

# Max connections per API instance (keep low on serverless)
PG_POOL_MAX=5
