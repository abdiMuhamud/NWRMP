# Base URL of the NWRMP API. Leave empty in development (Vite proxies /api to localhost:3001).
# On Vercel set it to the API project's URL, e.g. https://nwrmp-api.vercel.app/api
VITE_API_BASE_URL=

# MapLibre style URL for the basemap. Defaults to OpenFreeMap (OpenStreetMap data, no API key).
# For production, self-host OSM tiles (PMTiles) on government infrastructure.
VITE_MAP_STYLE_URL=
