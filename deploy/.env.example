# NWRMP deployment settings. Copy to deploy/.env and fill in:
#   cp .env.example .env && chmod 600 .env

# Address users type to reach the server: its IP address for now (e.g. 10.20.30.40),
# or a DNS name later (e.g. nwrmp.example.gov). Used by the certificate scripts.
NWRMP_HOST=

# https (default): needs a certificate in deploy/certs (scripts/make-test-cert.sh for an IP address).
# http: plain HTTP, no certificate. Testing only: passwords travel unencrypted, and phones need a
# Chrome setting for GPS, offline mode and "Install app" (see the runbook, section 6).
NWRMP_PROTOCOL=https

# Host ports users connect to. Change them when another web server on this machine already uses
# 80 or 443, e.g. NWRMP_HTTP_PORT=8080. With NWRMP_PROTOCOL=http nothing listens on the HTTPS
# port: set NWRMP_HTTPS_PORT=127.0.0.1:8443 so it does not take a public port.
NWRMP_HTTP_PORT=80
NWRMP_HTTPS_PORT=443

# Database password: letters and digits only (it is placed in a connection URL).
# Generate one with:  openssl rand -hex 24
# Only used when the database is first created; changing it later needs ALTER USER (see the runbook).
POSTGRES_PASSWORD=

# Server time zone for logs and timestamps
TZ=Africa/Mogadishu

# Image tag, e.g. the git commit or release being deployed
NWRMP_VERSION=latest

# Database connections per API instance
PG_POOL_MAX=10

# Optional: basemap style URL (defaults to OpenFreeMap, which needs internet access from users' devices)
VITE_MAP_STYLE_URL=
