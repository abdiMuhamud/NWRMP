{
  "name": "nwrmp-api",
  "version": "0.1.0",
  "private": true,
  "description": "NWRMP backend API (NestJS + PostgreSQL/PostGIS)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx src/cli.ts migrate",
    "db:seed": "tsx src/cli.ts seed",
    "db:reset": "tsx src/cli.ts seed --reset",
    "users:demo": "tsx src/cli.ts users:demo",
    "users:create": "tsx src/cli.ts users:create",
    "users:import": "tsx src/cli.ts users:import",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@vercel/blob": "^2.8.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-postgis": "0.2.10",
    "@nestjs/cli": "^11.0.24",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
