# NWRMP site. Both servers are default servers, so the site answers on the server's IP address
# or on any DNS name pointed at it: moving from an IP to a domain later needs no change here,
# only a new certificate in deploy/certs.

# Docker's internal DNS: re-resolve the API container if it restarts with a new address.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80 default_server;
    server_name _;

    # Let's Encrypt HTTP-01 challenges (certbot --webroot), once a domain name is used.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Public certificate of the NWRMP Test CA, for installing on test phones and PCs
    # (only present when scripts/make-test-cert.sh was used). Served over HTTP on purpose:
    # devices need it before they can trust the HTTPS site.
    location = /nwrmp-test-ca.crt {
        alias /etc/nginx/certs/nwrmp-test-ca.crt;
        default_type application/x-x509-ca-cert;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Inspection photos are compressed on the phone; the API also limits each to 5 MB.
    client_max_body_size 10m;

    gzip on;
    gzip_types text/css application/javascript application/json application/manifest+json image/svg+xml;
    gzip_min_length 1024;

    root /usr/share/nginx/html;

    # API (same origin, so the session cookie works)
    location /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        set $api_upstream http://api:3001;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }

    # Hashed build files never change: cache for a year.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # The service worker and manifest must always be re-checked so updates reach phones.
    location ~ ^/(sw\.js|workbox-[^/]+\.js|manifest\.webmanifest)$ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # Single-page app: unknown paths load index.html.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
