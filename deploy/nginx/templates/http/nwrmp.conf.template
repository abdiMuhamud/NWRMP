# NWRMP over plain HTTP (NWRMP_PROTOCOL=http): for a test installation without a certificate.
# Passwords and session cookies travel unencrypted, and phones allow GPS, offline mode and
# "Install app" only after the Chrome setting described in the runbook. Use HTTPS for real data.

# Docker's internal DNS: re-resolve the API container if it restarts with a new address.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80 default_server;
    server_name _;

    # Container health check.
    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    set $nwrmp_hsts "";
    include /etc/nginx/snippets/nwrmp-app.conf;
}
